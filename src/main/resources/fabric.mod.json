{
	"schemaVersion": 1,
	"id": "lingochat",
	"version": "${version}",
	"name": "LingoChat",
	"description": "Click any chat message to translate it, and optionally auto-translate the messages you send.",
	"authors": [
		"Skiye"
	],
	"license": "MIT",
	"icon": "assets/lingochat/icon.png",
	"contact": {
		"homepage": "https://github.com/rhyssniffing-coder/LingoChat",
		"sources": "https://github.com/rhyssniffing-coder/LingoChat",
		"issues": "https://github.com/rhyssniffing-coder/LingoChat/issues"
	},
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.lingochat.LingoChat"
		]
	},
	"mixins": [
		"lingochat.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.0",
		"minecraft": "${minecraft_version}",
		"java": ">=21",
		"fabric-api": "*"
	}
}
